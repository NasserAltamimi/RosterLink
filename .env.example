# Copy to .env. Keep real credentials and secrets out of Git.
MONGODB_URI=mongodb://127.0.0.1:27017/rosterlink
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=.local-data/uploads
NODE_ENV=development
# Production: HTTPS required. Set TRUST_PROXY=1 only behind one trusted proxy.
TRUST_PROXY=0
# Server-side catalog sync and competition lookup. Manual profile entry works without it.
PANDASCORE_API_TOKEN=
